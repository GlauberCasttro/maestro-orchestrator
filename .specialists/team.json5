     {facts: ["conv.indent.typescript", "conv.js.semicolons", "conv.js.quotes", "conv.naming.interface.typescript", "conv.naming.files.typescript"], paths: ["frontend/**"], text: "TS/TSX: indentação de 2 espaços, ponto-e-vírgula em todo import, aspas simples na maioria dos imports, interfaces em PascalCase, nomes de arquivo em kebab-case na maioria (exceção: maestroUI.tsx)."},
