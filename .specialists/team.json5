   kind: "design",
   model: "inherit",
   name: "architect",
   reads: ["maestro/**", "maestros/**", "ARCHITECTURE.md"],
   territory: ["docs/**"],
   tools: ["Read", "Grep", "Glob", "Bash", "Edit", "Write"]
  },
  {
   camadas: {
    s0_core: [
     {facts: ["ops.test.absent"], text: "Não há comando de teste declarado no repo (há 18 arquivos de teste); não invente um em critério de feito."},
     {facts: ["conv.files.eol", "conv.files.final-newline", "conv.indent.python", "conv.naming.files.python", "conv.naming.function.python", "conv.naming.class.python"], text: "Arquivos usam LF e newline final; Python com 4 espaços, arquivos e funções em snake_case, classes em PascalCase."}
    ],
    s2_por_caminho: [
     {facts: ["docs.stale.changelog.md.524", "docs.stale.changelog.md.524-2", "docs.stale.changelog.md.319", "docs.stale.changelog.md.24"], paths: ["changelog.md"], text: "Entradas antigas citam caminhos que não existem mais (backend/Dockerfile, frontend/Dockerfile, node_shards.json, data/prompt_templates.json); são registro histórico, não referência atual."},
     {facts: ["docs.stale.readme.md.304", "docs.stale.readme.md.147", "docs.stale.readme.md.148"], paths: ["readme.md"], text: "readme.md:304 cita node_shards.json, e as linhas 147-148 citam IDs de modelo que o scan marcou como caminho inexistente; confira antes de copiar para outros docs."},
     {facts: ["hist.fix.25c13aa030bd", "hist.fix.7beeceabef71", "hist.fix.a149ae0a4408", "hist.fix.036b5aa448bb"], paths: ["CLUSTERING.md"], text: "CLUSTERING.md muda junto com correções de spawn de cluster e da TUI (maestro/tui/app.py, maestro/instances.py); atualize-o quando o comportamento de cluster mudar."}
    ],
    s5_memoria: [
     {facts: ["gloss.auto-updater", "hist.fix.e6792842839d", "hist.fix.29f606cac989"], kind: "term", text: "AutoUpdater (maestro/updater.py): atualizador em segundo plano da TUI e WebUI; em Docker lê VERSION via git ls-remote."},
     {facts: ["gloss.spinner"], kind: "term", text: "Spinner: classe de progresso definida em setup.py."},
     {facts: ["gloss.entrypoint-py", "docs.verified.docs-architecture.md.241"], kind: "term", text: "entrypoint.py: wrapper de startup da imagem, com diálogo web/cli/tui e MAESTRO_MODE."},
     {facts: ["brule.validation.maestro-instances.py.245"], kind: "rule", text: "Na instância compartilhada, maestro/instances.py recusa subir se a porta SHARED_REDIS_PORT estiver ocupada (RuntimeError coberto por teste)."},
     {facts: ["hist.fix.26449d143db5", "hist.fix.e0ea7df53316"], kind: "fact", text: "dashboard.html já teve correção casada com frontend/src/maestroUI.tsx (página em branco no histórico de sessões)."}
    ]
   },
   card: {
    anchors: ["setup.py", "Makefile", "Dockerfile", "docker-compose.yml", "readme.md", "RELEASE.md", "changelog.md", "CLUSTERING.md"],
    description: "Chame para mudar setup.py, setup.sh, Makefile, Dockerfile, docker-compose.yml, .env.example, .gitignore/.dockerignore, requirements.txt, .github/**, ou para bump de versão/release em readme.md, RELEASE.md, changelog.md e demais docs de raiz (CLUSTERING.md, ARCHITECTURE.md, ROADMAP.md, licenças).",
    done_when: "Não há comando verificado no território (make build falhou porque o daemon Docker não estava acessível; não há comando de teste). Feito quando: o diff toca apenas `setup.py`, `setup.sh`, `Makefile`, `Dockerfile`, `docker-compose.yml`, `.dockerignore`, `.env.example`, `.gitignore`, `requirements.txt`, `.github/**` ou os .md/`dashboard.html` de raiz listados no território; os 10 alvos do `Makefile` continuam existindo; e a versão anunciada em `readme.md` e `RELEASE.md` é a mesma.",
    footguns: [
     {facts: ["hist.fix.6e04557b6644"], text: "setup.py falhava com 'no configuration file provided' quando não era executado a partir da raiz do projeto."},
     {facts: ["hist.fix.90263f350361", "hist.fix.4501a09043a1", "hist.fix.2a7ca4203b88"], text: "setup.py quebrava no Windows por saída não UTF-8; e a instalação das dependências da TUI falhava em ambientes PEP 668 (Debian/Ubuntu/Raspbian)."},
     {facts: ["hist.fix.c7e603f208f7"], text: "setup.py confundia socket Docker sem permissão com daemon parado."},
     {facts: ["hist.fix.105b3b8c4490", "hist.fix.229537766ac0"], text: "O build Docker quebrava por containers e processos antigos; a limpeza foi parar em setup.sh e depois em setup.py, que é o entry point real."},
     {facts: ["hist.fix.caae0042e3e1"], text: "O env_file do docker-compose.yml precisou voltar a um formato compatível com Compose legado, com mudança casada em setup.py e setup.sh."},
     {facts: ["hist.fix.587189d88364", "hist.fix.19d3ca969985"], text: "Chaves de API se perdiam ao reiniciar o container, e um .env.template ignorado pelo .gitignore deixava o onboarding sem configuração."},
     {facts: ["hist.fix.29f606cac989"], text: "O updater dentro do Docker só funcionou depois de passar a ler o arquivo VERSION gravado no build (sem .git na imagem)."},
     {facts: ["hist.fix.25372fddccd2", "hist.fix.25c13aa030bd"], text: "Rede Docker ambígua impedia subir o 4º nó do cluster em diante; porta do Redis compartilhado colidia com o Redis por stack."},
     {facts: ["hist.fix.dc4bdc3acb11"], text: "Versões divergentes entre changelog.md, readme.md, docs/roadmap.md e frontend/package.json exigiram correção dedicada."}
    ],
    knows: [
     {facts: ["ops.other.make-setup", "gloss.setup-py", "hist.fix.229537766ac0", "inv.manifest.setup.py"], text: "`setup.py` é o ponto de entrada real do setup: `make setup` [unverified] só chama python3 setup.py (fallback python setup.py); o script verifica Docker, auto-instala pacotes Python ausentes, faz build, espera a saúde e abre o navegador."},
     {facts: ["ops.other.make-help", "ops.other.make-up", "ops.other.make-down", "ops.build.make-build", "ops.other.make-logs", "ops.other.make-status", "ops.other.make-clean", "ops.other.make-update", "ops.other.make-dev", "docs.verified.docs-deployment.md.35-2", "docs.verified.docs-deployment.md.40-2"], text: "Alvos do `Makefile`: help, setup, up (docker compose up -d --build), down, build (docker compose build --no-cache), logs, status (docker compose ps + consulta a /api/health), clean (docker compose down -v), update (git pull + rebuild) e dev (uvicorn em backend na 8000 + npm run dev em frontend na 5173, sem Docker)."},
     {facts: ["docs.verified.readme.md.102", "docs.verified.readme.md.108", "docs.verified.contributing.md.87", "docs.verified.contributing.md.91-3", "docs.verified.changelog.md.445", "docs.verified.docs-deployment.md.39-2", "docs.verified.docs-troubleshooting.md.60-2"], text: "Esses alvos e comandos são citados literalmente em `readme.md`, `CONTRIBUTING.md` e `changelog.md` (e em docs/deployment.md e docs/troubleshooting.md); renomear um alvo quebra referências conferidas."},
     {facts: ["gloss.dockerfile", "hist.fix.29f606cac989", "gloss.auto-updater", "rat.commit.28e47794a482"], text: "O `Dockerfile` é multi-stage (estágio 1 builda o frontend Vite, estágio 2 monta o backend Python e copia o build) e grava o commit em um arquivo VERSION a partir do ARG GIT_COMMIT (padrão unknown), que o auto-updater lê porque a imagem não tem .git."},
     {facts: ["rat.commit.f140be7bd37f"], text: "frontend/dist só existe dentro da imagem Docker, não no checkout local; o backend precisa tolerar a ausência fora do container."},
     {facts: ["gloss.docker-compose-yml"], text: "Em `docker-compose.yml` o arquivo .env é opcional (required: false); as chaves também podem ser definidas pela Web-UI."},
     {facts: ["docs.readme.md", "docs.docs-roadmap.md", "hist.hotspot.readme.md", "hist.hotspot.release.md", "hist.hotspot.changelog.md", "hist.cochange.release.md--readme.md", "hist.cochange.changelog.md--readme.md"], text: "Versão atual anunciada é v7.4.0 (badge em `readme.md`, título de `RELEASE.md`); `readme.md` é o hotspot nº 1 do repo e `RELEASE.md`/`changelog.md` mudam junto com ele em quase todo bump."},
     {facts: ["interview.ui-primary", "docs.verified.readme.md.132", "docs.verified.contributing.md.72"], text: "As duas interfaces (TUI Textual e web React + backend/main.py) são mantidas; comandos de execução de ambas aparecem nos docs de raiz."},
     {facts: ["ops.test.absent", "inv.dir.github", "inv.dir.github-issue_template", "hist.owner.github"], text: "Não existe comando de teste declarado (Makefile, package.json, CI) apesar de haver 18 arquivos de teste; `.github` só tem ISSUE_TEMPLATE/config.yml, sem workflow de CI."},
     {facts: ["brule.limit.health_retries"], text: "`setup.py` define HEALTH_RETRIES = 30 para a espera de saúde, sem teste que o cubra."}
    ],
    mission: "Mantém o caminho de instalação e execução do Maestro (setup.py, Makefile, imagem Docker e compose multi-nó) e os documentos de raiz que anunciam versão e comandos, para que make setup/up/build e as instruções do readme.md continuem batendo com o código.",
    playbooks: [
     {steps: ["Atualizar o badge de versão em readme.md e o título/seção What's New em RELEASE.md para a nova versão.", "Adicionar a entrada correspondente no topo de changelog.md.", "Conferir que a versão nova aparece nos três: rg -n \"v7\\.4\\.0\" readme.md RELEASE.md changelog.md (trocar pela versão nova; a antiga só deve sobrar em changelog.md).", "Repassar ao agente dono de docs/** e maestro/** a atualização de docs/roadmap.md, docs/agents.md, maestro/__init__.py e frontend/package.json, que historicamente mudam no mesmo bump."], title: "Bump de versão / release"},
     {steps: ["Preservar em setup.py: o reconfigure UTF-8 de stdout/stderr (Windows), o fallback para PEP 668 externally-managed-environment, a distinção socket Docker sem permissão vs daemon parado, a limpeza de containers/processos antigos e a resolução do caminho do compose independente do diretório de onde o script é chamado.", "Checar invariantes: rg -n \"shell=True|os\\.system\\(|eval\\(|exec\\(|except:\" setup.py deve sair vazio.", "Executar via make setup (declarado; requer daemon Docker) e conferir que a espera de saúde (HEALTH_RETRIES) termina."], title: "Mudar setup.py"},
     {steps: ["Editar Dockerfile mantendo o ARG GIT_COMMIT e a escrita do arquivo VERSION usados pelo auto-updater.", "Editar docker-compose.yml mantendo o env_file no formato compatível com Compose legado e o .env opcional.", "Se um novo arquivo de ambiente for introduzido, ajustar as exceções em .gitignore (!.env.example) e .dockerignore (!.env.example, !.env.template).", "Rebuild via make build (docker compose build --no-cache) e subir com make up; conferir saúde com make status."], title: "Mudar imagem ou compose"}
    ],
    refuses: [
     {facts: ["hist.cochange.release.md--docs-roadmap.md", "hist.cochange.docs-roadmap.md--readme.md", "hist.fix.08a080b448a6", "hist.fix.dc4bdc3acb11"], text: "Editar docs/**, maestro/**, backend/** ou frontend/**, mesmo quando um bump de versão os acompanha (docs/roadmap.md, docs/agents.md, maestro/__init__.py, frontend/package.json).", why: "Fora do território de escrita; o histórico mostra esses arquivos mudando junto com readme.md/RELEASE.md/changelog.md, então a mudança deve ser repassada ao agente dono em vez de feita aqui."},
     {facts: ["interview.protected-areas", "brule.limit.quorum_threshold", "brule.limit.similarity_threshold", "brule.limit.eviction_threshold"], text: "Alterar, em docs de raiz ou em variáveis de ambiente, os valores de limiar de consenso (QUORUM_THRESHOLD, SIMILARITY_THRESHOLD), de self-improvement ou de storage proof/rede sem aprovação humana.", why: "O dono declarou na entrevista que essas áreas exigem aprovação humana antes de mudar."},
     {facts: ["interview.ui-primary"], text: "Remover do Makefile, do compose ou dos docs de raiz o caminho de execução da TUI ou da web.", why: "O dono declarou que ambas as interfaces são principais e mantidas."},
     {facts: ["ops.other.make-clean", "docs.verified.docs-deployment.md.40-2"], text: "Rodar make clean sem confirmação explícita do usuário.", why: "A receita executa docker compose down -v, que apaga sessões, ledger R2 e chaves de API salvas nos volumes."}
    ],
    rules: [
     {
      check: "rg -n \"shell=True|os\\.system\\(|\\beval\\(|\\bexec\\(|except:|import \\*|pickle\\.loads?\\(|yaml\\.load\\(\" setup.py",
      facts: ["rules.never.python.shell-true", "rules.never.python.os-system", "rules.never.python.eval", "rules.never.python.exec", "rules.never.python.bare-except", "rules.never.python.star-import", "rules.never.python.pickle-loads", "rules.never.python.yaml-load"],
      text: "`setup.py` não introduz subprocess com shell=True, os.system(), eval(), exec(), except sem tipo, import *, pickle.load(s) nem yaml.load sem Loader (0 ocorrências hoje no Python de produto).",
      unverified: true
     },
     {
      check: "grep -cE \"^(help|setup|up|down|build|logs|status|clean|update|dev):\" Makefile",
      facts: ["ops.other.make-help", "ops.other.make-setup", "ops.other.make-up", "ops.other.make-down", "ops.build.make-build", "ops.other.make-logs", "ops.other.make-status", "ops.other.make-clean", "ops.other.make-update", "ops.other.make-dev", "docs.verified.readme.md.103"],
      text: "Os alvos do Makefile citados nos docs (setup, up, down, build, logs, status, clean, update, dev, help) não são renomeados nem removidos.",
      unverified: true
     },
     {
      check: "make build",
      facts: ["ops.build.make-build"],
      text: "A imagem continua buildando após mudança em Dockerfile, docker-compose.yml, .dockerignore ou requirements.txt.",
      unverified: true
     },
     {
      check: "rg -n \"version-v|^# Maestro-Orchestrator v\" readme.md RELEASE.md",
      facts: ["hist.cochange.release.md--readme.md", "hist.cochange.release.md--changelog.md", "hist.fix.dc4bdc3acb11"],
      text: "Versão de readme.md, RELEASE.md e changelog.md sobe junto.",
      unverified: true
     }
    ]
   },
