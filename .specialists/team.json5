", "stack.node.imports", "stack.node.react", "stack.node.react-dom", "stack.node.rollup", "stack.node.types-react", "stack.node.types-react-dom", "stack.node.typescript", "stack.node.vite", "stack.node.vitejs-plugin-react", "stack.python.imports"],
