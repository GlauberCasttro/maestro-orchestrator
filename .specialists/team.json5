     {facts: ["gloss.cluster-dashboard", "gloss.status-bar", "gloss.agent-panel", "gloss.consensus-panel", "gloss.response-viewer", "gloss.shard-network-panel"], kind: "term", text: "ClusterDashboard, StatusBar, Agent Panel, Consensus Panel, Response Viewer, Shard Network Panel: widgets em `maestro/tui/widgets.py`."},
     {facts: ["gloss.maestro-plugin", "gloss.plugin-manifest", "gloss.plugin-context"], kind: "term", text: "MaestroPlugin, PluginManifest e PluginContext (acesso controlado do plugin ao sistema) em `maestro/plugins/base.py`."},
