     {facts: ["gloss.discover", "gloss.enable", "gloss.disable", "gloss.reload", "gloss.config", "gloss.snapshots", "gloss.restore", "gloss.diff"], kind: "fact", text: "Rotas de plugins em `maestro/api_plugins.py`: discover, enable, disable, reload, config, snapshots, restore, diff."},
     {facts: ["gloss.check", "gloss.apply", "gloss.remote", "gloss.restart", "gloss.auto"], kind: "fact", text: "Rotas de update em `maestro/api_update.py`: check, apply, remote, restart, auto."},
     {facts: ["rat.commit.a7e9ac7fd9a7"], kind: "fact", text: "O auto-updater nasceu para evitar re-clonar o repo manualmente."},
     {facts: ["hist.cochange.docs-mod-manager.md--maestro-plugins-manager.py", "hist.cochange.maestro-node_server.py--maestro-plugins-manager.py", "hist.cochange.release.md--maestro-plugins-manager.py", "hist.cochange.changelog.md--maestro-plugins-manager.py", "hist.cochange.maestro-plugins-manager.py--readme.md", "hist.cochange.docs-roadmap.md--maestro-plugins-manager.py"], kind: "fact", text: "Mod Manager co-muda com docs/mod-manager.md, maestro/node_server.py, RELEASE.md, changelog.md, readme.md e docs/roadmap.md."}
