    s5_memoria: [
     {facts: ["gloss.agent-error", "gloss.dissent-data", "gloss.ncg-benchmark", "gloss.r2-data", "gloss.shard-model", "gloss.network-topology", "gloss.instance-info", "gloss.download-status"], kind: "term", text: "AgentError, DissentData, NcgBenchmark, R2Data, ShardModel, NetworkTopology, InstanceInfo e download-status são interfaces definidas em frontend/src/maestroUI.tsx."},
     {facts: ["gloss.strong", "gloss.acceptable", "gloss.weak", "gloss.suspicious"], kind: "term", text: "Notas de sessão do R2: strong = quorum atingido, drift baixo, sem colapso nem outliers; acceptable = quorum com ressalvas; weak = quorum não atingido ou dissenso interno alto; suspicious = colapso silencioso ou concordância muito alta com drift NCG alto."},
     {facts: ["gloss.web-ui", "gloss.session-history"], kind: "term", text: "Web UI = dashboard completo (API + React UI); Session History = log JSON persistente de cada sessão de orquestração."},
     {facts: ["gloss.reputation-score", "gloss.node-reputation"], kind: "term", text: "Reputation score vem do motor de proof-of-storage (NodeReputation em maestro/storage_proof.py)."},
     {facts: ["hist.owner.frontend"], kind: "fact", text: "Autor principal do frontend no histórico: Claude (88% de 100 toques); outro: defcon."},
