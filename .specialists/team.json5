     {facts: ["hist.cochange.maestro-node_server.py--maestro-plugins-manager.py", "hist.cochange.changelog.md--maestro-node_server.py", "hist.cochange.docs-roadmap.md--maestro-node_server.py"], paths: ["maestro/node_server.py"], text: "Mudança de versão aqui acompanha _MAESTRO_VERSION em maestro/plugins/manager.py e as entradas em changelog.md e docs/roadmap.md."}
    ],
    s5_memoria: [
     {facts: ["gloss.shard-descriptor"], kind: "term", text: "ShardDescriptor (maestro/storage_proof.py): descritor de shard construído a partir dos arquivos reais em disco."},
     {facts: ["gloss.shard-identity", "gloss.peer-shard", "gloss.shard-discovery-engine", "gloss.msg-type"], kind: "term", text: "ShardIdentity, PeerShard e ShardDiscoveryEngine (maestro/lan_discovery.py): identidade local, peer descoberto e motor de descoberta na LAN; MsgType enumera as mensagens do protocolo."},
     {facts: ["gloss.cluster-config", "gloss.state-bus"], kind: "term", text: "ClusterConfig (maestro/cluster.py) e StateBus (maestro/state_bus.py)."},
     {facts: ["gloss.activation-payload", "gloss.pipeline-construction"], kind: "term", text: "ActivationPayload (maestro/node_server.py): payload de ativação trocado entre nós no pipeline de inferência."},
     {facts: ["gloss.proof-of-storage", "gloss.shard-net"], kind: "term", text: "Proof-of-storage: a confiança distribuída exige verificação criptográfica, não só heartbeats. ShardNet é o nome de produto da inferência distribuída com proof-of-storage."},
     {facts: ["graph.central.maestro-shard_manager.py", "graph.central.maestro-shard_utils.py", "graph.central.maestro-instances.py"], kind: "fact", text: "maestro/shard_manager.py, maestro/shard_utils.py e maestro/instances.py são centrais (PageRank #14, #12 e #13; cada um importado por 3 arquivos)."},
     {facts: ["conv.python.future-annotations"], kind: "rule", text: "`from __future__ import annotations` não é usado em 94% dos arquivos Python; maestro/instances.py é uma das exceções."},
     {facts: ["gloss.register", "gloss.topology", "gloss.pipeline", "gloss.redundancy", "gloss.reputation", "gloss.download", "gloss.verify", "gloss.disk-usage", "gloss.generate-config", "gloss.discovery", "gloss.peers", "gloss.dispatch", "gloss.routing", "gloss.challenge"], kind: "fact", text: "Rotas de storage em maestro/api_storage.py: register, topology/network, pipeline, redundancy, reputation, models/shards, download, verify, disk-usage, generate-config, discovery, peers, node. Rotas de cluster em maestro/api_cluster.py: status, dispatch, challenge/proof, routing."}
    ]
